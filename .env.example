# Docker Compose / Traefik – Vorlage für .env (die .env nicht einchecken).
# Die Laravel-Einstellungen stehen getrennt in src/.env.

# Öffentlicher Hostname (DNS → Traefik). Muss zu APP_URL in src/.env passen.
APP_DOMAIN=telephony.example.de

# Traefik: externes Docker-Netz, Entrypoint, Zertifikats-Resolver (siehe Traefik-Konfiguration)
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=myresolver
# Name für Router, Service und Middleware – je Traefik-Instanz eindeutig
TRAEFIK_ROUTER=telephony

# Container- und Image-Namen
CONTAINER_PREFIX=telephony
APP_IMAGE=telephony-app

# Besitzer von src/ auf dem Host (id -u / id -g); PHP läuft mit diesen IDs
HOST_UID=1000
HOST_GID=100
