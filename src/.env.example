# Vorlage für src/.env – leere Werte erzeugen (siehe README, „Neu aufsetzen“).
APP_NAME="Anrufanzeige"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://telephony.froehler-kollegen.de
APP_TIMEZONE=Europe/Berlin
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=sqlite

# Sitzung: verschlüsselt, nur über HTTPS, nicht per JavaScript lesbar
SESSION_DRIVER=redis
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="telephony@froehler-kollegen.de"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb: Server im Container "reverb" (intern), Browser über nginx /app
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081
REVERB_ALLOWED_ORIGINS=telephony.froehler-kollegen.de

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=telephony.froehler-kollegen.de
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Anmeldung: Zwei-Faktor-Pflicht
AUTH_REQUIRE_2FA=true

# Telephony
TELEPHONY_PUSH_QUEUE=telephony
# Nur diese Benutzer-IDs dürfen Anrufe sehen (leer = alle angemeldeten)
TELEPHONY_USERS=
SIPGATE_WEBHOOK_TOKEN=
# Absender von push-api.sipgate.net
SIPGATE_WEBHOOK_IPS=217.116.118.254,212.9.46.32

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Web-Push (Kontakt für die Push-Dienste)
VAPID_SUBJECT=mailto:admin@example.com
